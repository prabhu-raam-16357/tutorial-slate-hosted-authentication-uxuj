@font-face {
  font-family: "Lato";
  font-style: normal;
  font-weight: 400;
  font-display: swap;
  src: url("https://webfonts.zohowebstatic.com/latoregular/font.woff2") format("woff2");
}

@font-face {
  font-family: "Lato";
  font-style: normal;
  font-weight: 700;
  font-display: swap;
  src: url("https://webfonts.zohowebstatic.com/latobold/font.woff2") format("woff2");
}

:root {
  --password-primary: #147d73;
  --password-primary-hover: #0f675f;
  --password-primary-soft: #e7f4f1;
  --password-text: #172126;
  --password-muted: #65747b;
  --password-border: #d8e0e3;
  --password-field: #f7f9fa;
  --password-surface: #ffffff;
  --password-background: #eef3f4;
  --password-danger: #c83d4d;
  --password-success: #16865f;
  --password-focus: rgba(20, 125, 115, 0.18);
  --password-radius: 6px;
}

html,
body {
  margin: 0;
  min-height: 100%;
  color: var(--password-text);
  background: var(--password-background);
  font-family: "Lato", sans-serif !important;
  font-weight: 400;
  letter-spacing: 0;
}

*,
*::before,
*::after {
  box-sizing: border-box;
  font-family: inherit;
}

.bg_one {
  display: none !important;
}

.recovery_container {
  width: min(100%, 460px);
  min-height: 0;
  margin: 24px auto;
  overflow: visible;
  background: var(--password-surface);
  border: 1px solid var(--password-border);
  border-radius: 8px;
  box-shadow: 0 16px 40px rgba(20, 37, 43, 0.1);
}

.recovery_box {
  width: 100%;
  min-height: 0;
  padding: 36px;
  overflow: visible;
  background: transparent;
  border: 0;
  border-radius: inherit;
}

#change_password_div,
#password_matched_div {
  width: 100%;
}

#change_password_div .titlename,
#change_password_div .info_head,
#password_matched_div .titlename,
#password_matched_div .info_head {
  margin: 0 0 10px;
  color: var(--password-text);
  font-size: 22px;
  font-weight: 700;
  line-height: 30px;
  letter-spacing: 0;
  text-transform: none;
}

#change_password_div .head_info,
#password_matched_div .head_info {
  margin: 0 0 24px;
  color: var(--password-muted);
  font-size: 14px;
  font-weight: 400;
  line-height: 21px;
}

#change_password_div .textbox_div {
  position: relative;
  margin-bottom: 22px;
}

#change_password,
#reneter_password {
  display: block;
  width: 100%;
  height: 44px;
  padding: 0 46px 0 13px;
  color: var(--password-text);
  background: var(--password-field);
  border: 1px solid var(--password-border);
  border-radius: var(--password-radius);
  outline: none;
  font-size: 15px;
  text-indent: 0;
  transition: border-color 120ms ease, box-shadow 120ms ease,
    background-color 120ms ease;
}

#change_password:hover,
#reneter_password:hover {
  border-color: #aab8bd;
}

#change_password:focus,
#reneter_password:focus {
  background: var(--password-surface);
  border-color: var(--password-primary);
  box-shadow: 0 0 0 3px var(--password-focus);
}

#change_password::placeholder,
#reneter_password::placeholder {
  color: #849198;
  opacity: 1;
}

#change_password.errorborder,
#reneter_password.errorborder,
#change_password_div .errorborder {
  border-color: var(--password-danger) !important;
  box-shadow: 0 0 0 3px rgba(200, 61, 77, 0.12);
}

#change_password_div .fielderror,
#change_password_div .errorlabel {
  display: none;
  margin-top: 6px;
  color: var(--password-danger);
  font-size: 13px;
  line-height: 18px;
}

#change_password_div .show_hide_password {
  position: absolute;
  top: 11px;
  right: 13px;
  float: none;
  color: var(--password-muted);
  font-size: 22px;
  line-height: 22px;
  cursor: pointer;
}

#change_password_div .show_hide_password:hover {
  color: var(--password-text);
}

#change_password_div .pass_policy {
  margin: -10px 0 20px;
  padding: 0;
  color: var(--password-muted);
  font-size: 13px;
  line-height: 19px;
}

#change_password_div .hover-tool-tip {
  position: relative;
  top: auto;
  right: auto;
  bottom: auto;
  left: auto;
  width: 100%;
  margin: -8px 0 20px;
  padding: 14px;
  opacity: 1;
  color: var(--password-text);
  background: var(--password-surface);
  border: 1px solid var(--password-border);
  border-radius: var(--password-radius);
  box-shadow: none;
}

#change_password_div .hover-tool-tip::after {
  display: none;
}

#change_password_div .hover-tool-tip p {
  margin: 0 0 8px;
  font-size: 13px;
  font-weight: 700;
}

#change_password_div .hover-tool-tip ul {
  margin: 0;
  padding: 0;
  list-style: none;
}

#change_password_div .hover-tool-tip li {
  display: flex;
  align-items: center;
  min-height: 24px;
  color: var(--password-muted);
  font-size: 12px;
  line-height: 18px;
  white-space: normal;
}

#change_password_div .hover-tool-tip li::before {
  content: "";
  flex: 0 0 7px;
  width: 7px;
  height: 7px;
  margin-right: 9px;
  background: var(--password-danger);
  border-radius: 50%;
}

#change_password_div .hover-tool-tip li.success::before {
  background: var(--password-success);
}

#change_password_div .btn,
#change_password_div .blue,
#change_password_submit {
  display: block;
  width: 100%;
  min-height: 44px;
  margin: 8px 0 0;
  padding: 0 18px;
  color: #ffffff !important;
  background: var(--password-primary) !important;
  border: 0;
  border-radius: var(--password-radius);
  outline: none;
  cursor: pointer;
  font-size: 14px;
  font-weight: 700;
  letter-spacing: 0;
  text-transform: none;
  transition: background-color 120ms ease, box-shadow 120ms ease,
    transform 120ms ease;
}

#change_password_div .btn:hover,
#change_password_div .blue:hover,
#change_password_submit:hover {
  background: var(--password-primary-hover) !important;
}

#change_password_div .btn:focus-visible,
#change_password_submit:focus-visible,
#change_password_div .show_hide_password:focus-visible {
  outline: 3px solid var(--password-focus);
  outline-offset: 2px;
}

#change_password_div .btn:active,
#change_password_submit:active {
  transform: translateY(1px);
}

#change_password_div .changeloadbtn {
  width: 44px;
  padding: 0;
  border-radius: 50%;
}

#change_password_div .changeloadbtn::before {
  border-color: #ffffff;
  border-top-color: rgba(255, 255, 255, 0.35);
}

#password_matched_div {
  padding: 8px 0;
  text-align: center;
}

#password_matched_div .tick_icon {
  float: none;
  width: 42px;
  height: 42px;
  margin: 0 auto 18px;
  background: var(--password-success);
}

#password_matched_div .tick_icon::after {
  width: 17px;
  height: 9px;
  margin: 13px 11px;
  border-bottom-width: 3px;
  border-left-width: 3px;
}

#password_matched_div .btn,
#password_matched_div .blue {
  width: 100%;
  min-height: 44px;
  margin: 22px 0 0;
  color: #ffffff !important;
  background: var(--password-primary) !important;
  border: 0;
  border-radius: var(--password-radius);
  font-size: 14px;
  font-weight: 700;
  text-transform: none;
}

.Alert,
.Errormsg {
  max-width: min(600px, calc(100% - 32px));
  color: #ffffff;
  background: #24343a;
  border-radius: var(--password-radius);
  box-shadow: 0 12px 32px rgba(20, 37, 43, 0.18);
}

.error_icon {
  background: var(--password-danger);
}

.tick_icon {
  background: var(--password-success);
}

.loader {
  border-color: var(--password-primary);
  border-bottom-color: transparent;
}

.blur {
  background: var(--password-surface);
}

@media (max-width: 600px) {
  html,
  body {
    background: var(--password-surface);
  }

  .recovery_container {
    width: 100%;
    margin: 0;
    border: 0;
    border-radius: 0;
    box-shadow: none;
  }

  .recovery_box {
    padding: 28px 22px 36px;
  }

  #change_password_div .titlename,
  #change_password_div .info_head,
  #password_matched_div .titlename,
  #password_matched_div .info_head {
    font-size: 20px;
    line-height: 28px;
  }

  .Alert,
  .Errormsg {
    min-width: 0;
    width: calc(100% - 24px);
  }
}
