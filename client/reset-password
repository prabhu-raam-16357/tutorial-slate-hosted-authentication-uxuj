/* overwrite css for forget password */

* {
  font-family: latoReg, sans-serif !important;
}

:root {
  --body-bgColor: #ffff;
  --primary-color: #ffff;
}

.titlename,
#headtitle,
.head_info {
  display: none !important;
}

.recovery_box,
.recovery_container {
  min-height: auto;
}

#nextbtn,
#last_pwd_submit,
#username_select_action,
.auth-signup-btn {
  background-color: var(--primary-color);
}

.change_user,
.bottom_option {
  color: var(--primary-color);
}



#Last_password_div .show_hide_password {
  top: -30px;
}

/* #captcha_container{
  display: none !important;
 
} */

.auth-forget-btn {
  color: var(--primary-color);
  cursor: pointer;
}



input:disabled::-webkit-input-placeholder {
  /* WebKit browsers */
  color: #666666;
}
input:disabled:-moz-placeholder {
  /* Mozilla Firefox 4 to 18 */
  color: #666666;
}
input:disabled::-moz-placeholder {
  /* Mozilla Firefox 19+ */
  color: #666666;
}
input:disabled:-ms-input-placeholder {
  /* Internet Explorer 10+ */
  color: #666666;
}

.recovery_container {
  margin: 0px !important;
}

#otp_resend.nonclickelem{
  color: #626262;
}

#otp_resend,
.resend_text{
  color:  var(--primary-color);
  font-size: 14px;
    font-weight: 500;
    line-height: 16px;
}

#otp_confirm_submit, .blue{
  background-color:var(--primary-color) !important;
}

#change_password, #reneter_password, #login_id, #last_password,
#captcha {
  background: #f1f1f1;
  border: 1px solid #e4e4e4;
  padding-left: 10px;
  font-size: 15px;
  box-sizing: border-box;
  height: 40px;
  border-radius: 4px;
}

#change_password{
  padding-right: 50px;
}

.hover-tool-tip {
    top: auto !important;
    left: 30px !important;
    right: 30px !important;
    opacity: 1 !important;
    bottom: 30px;
    box-shadow: none;
    border: 1px solid #ededed;
    padding: 10px 20px;
}

.hover-tool-tip ul{
  margin-left: 0;
}

.rec_modes_other_options{
  display: none !important;
}
#login_id{
  text-indent: 0 !important;
}

.showcountry_code{
  display:none !important;
}

.Alert{
  display: none !important
  ;
}

#org_contact_support  #headtitle{
  display: block !important;
}

#org_contact_support .head_info{
  display: block !important;
  margin-left:35px;
  white-space: normal;
    word-break: break-word;
}

#lookup_div .info_head{
  display: none;
}


#terminate_session_form .checkbox_check:hover ~ .checkbox {
  border: 2px solid var(--primary-color);
}

#terminate_session_form .checkbox_check:checked ~ .checkbox {
  background-color: var(--primary-color);
  border-color: var(--primary-color);
}

.session_terminate_desc{
  font-size: 13px;
    margin: 10px;
    margin-left: 23px;
    display: block;
    color: #666;
}

#confirm_otp_div .info_head,
#username_div .info_head,
#Last_password_div .info_head{
  margin-bottom: 10px;
}

#confirm_otp_div .info_head .user_info_space,
#username_div .info_head .user_info_space,
#Last_password_div .info_head .user_info_space{
  margin-bottom: 10px;
}

#confirm_otp_div .info_head .head_info,
#username_div .info_head .head_info,
#Last_password_div .info_head .head_info{
  display: block !important;
  margin: 0;
  color: #111;
  font-size: 14px;
  margin: 0px 10px;
}

.commonErrorlabelForCaptcha {
  display: inline-block;
  color: #E92B2B;
  margin-bottom: 20px;
  font-size: 14px;
  margin-top: -15px;
}
